---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";
import type { TranslationKey } from "../i18n/ui";

interface TagItem {
  label: string;
  key?: TranslationKey;
}

interface Props {
  title: string;
  description: string;
  titleKey?: TranslationKey;
  descriptionKey?: TranslationKey;
  caseTitle: string;
  caseTitleKey?: TranslationKey;
  category?: string;
  categoryKey?: TranslationKey;
  year?: string;
  role?: string;
  roleKey?: TranslationKey;
  githubUrl?: string;
  demoUrl?: string;
  tags?: (string | TagItem)[];
}

const {
  title,
  description,
  titleKey,
  descriptionKey,
  caseTitle,
  caseTitleKey,
  category,
  categoryKey,
  year,
  role,
  roleKey,
  githubUrl,
  demoUrl,
  tags = [],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title || `${caseTitle} | ${SITE_TITLE}`}
      description={description}
      titleKey={titleKey}
      descriptionKey={descriptionKey}
    />
  </head>
  <body>
    <Header />

    <main class="case-study-page">
      <article class="case-container">
        <!-- Top Navigation Bar -->
        <div class="case-top-nav">
          <a href="/" class="back-link" data-i18n="action.back_portfolio">
            &larr; Back to Portfolio
          </a>

          <div class="top-nav-actions">
            {
              githubUrl && (
                <a
                  href={githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-github-nav"
                  data-i18n="action.view_github"
                >
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                  </svg>
                  <span>View on GitHub</span>
                </a>
              )
            }
            {
              demoUrl && (
                <a
                  href={demoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-demo-nav"
                  data-i18n="action.live_demo"
                >
                  <span>Live Demo</span>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17l10-10M17 17V7H7"/>
                  </svg>
                </a>
              )
            }
          </div>
        </div>

        <!-- Case Study Header / Hero -->
        <header class="case-header">
          {
            (category || categoryKey) && (
              <div class="case-category font-mono" data-i18n={categoryKey}>
                {category}
              </div>
            )
          }

          <h1 class="case-title" data-i18n={caseTitleKey}>
            {caseTitle}
          </h1>

          <!-- Metadata Grid: Role, Timeline, Stack -->
          <div class="case-meta-grid">
            {
              (role || roleKey) && (
                <div class="meta-cell">
                  <span class="meta-label font-mono" data-i18n="case.role">Role</span>
                  <span class="meta-value" data-i18n={roleKey}>{role}</span>
                </div>
              )
            }

            {
              year && (
                <div class="meta-cell">
                  <span class="meta-label font-mono" data-i18n="case.year">Timeline</span>
                  <span class="meta-value font-mono">{year}</span>
                </div>
              )
            }

            {
              tags.length > 0 && (
                <div class="meta-cell meta-cell-stack">
                  <span class="meta-label font-mono" data-i18n="case.stack">Core Stack</span>
                  <div class="case-tags-wrap">
                    {tags.map((t) => {
                      if (typeof t === "string") {
                        return <span class="tech-tag">{t}</span>;
                      }
                      return (
                        <span class="tech-tag" data-i18n={t.key}>
                          {t.label}
                        </span>
                      );
                    })}
                  </div>
                </div>
              )
            }
          </div>
        </header>

        <!-- Main Body Content Slot -->
        <div class="case-body">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  /* Global Layout Container */
  .case-study-page {
    width: 100%;
    min-height: 100vh;
    padding: 2.5rem 1.5rem 6rem 1.5rem;
  }

  .case-container {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* Top Navigation */
  .case-top-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .back-link:hover {
    color: var(--text-primary);
  }

  .top-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-github-nav,
  .btn-demo-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-github-nav {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
  }
  .btn-github-nav:hover {
    background: var(--bg-hover);
    border-color: var(--border-hover);
  }

  .btn-demo-nav {
    background: var(--accent);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
  }
  .btn-demo-nav:hover {
    background: var(--accent-hover);
  }

  /* Case Header */
  .case-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .case-category {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .case-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }

  /* Metadata Grid */
  .case-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .meta-cell {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .meta-cell-stack {
    grid-column: span 2;
  }

  .meta-label {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .meta-value {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .case-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Case Study Body Styling */
  .case-body {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .case-body h2 {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 2.5rem 0 1rem 0;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border-subtle);
    letter-spacing: -0.02em;
  }

  .case-body h3 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 1.75rem 0 0.75rem 0;
  }

  .case-body p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1.2rem;
  }

  /* Standardized Notice / Context Box */
  .info-box,
  .notice-box {
    background: radial-gradient(circle at 95% 5%, rgba(59, 130, 246, 0.06) 0%, transparent 60%), var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-left: 4px solid var(--accent);
    padding: 1.4rem 1.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .notice-box.emerald,
  .info-box.emerald {
    border-left-color: var(--emerald);
    background: radial-gradient(circle at 95% 5%, rgba(16, 185, 129, 0.06) 0%, transparent 60%), var(--bg-surface);
  }

  .info-box p,
  .notice-box p {
    margin: 0;
  }

  .info-box strong,
  .notice-box strong {
    color: var(--text-primary);
  }

  /* Standardized Video Wrappers */
  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    background: #000000;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.7);
    margin: 1.5rem 0 2.5rem 0;
  }

  .video-wrapper video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Mobile Frame Video Wrapper (for Portrait Apps like Quechua) */
  .mobile-video-container {
    display: flex;
    justify-content: center;
    margin: 2rem 0 2.5rem 0;
  }

  .mobile-video-wrapper {
    position: relative;
    width: 100%;
    max-width: 290px;
    border-radius: 28px;
    border: 8px solid #18181b;
    background: #000000;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), 0 0 0 1px var(--border-subtle);
  }

  .mobile-video-wrapper video {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Standardized Numbered Step List */
  .step-list,
  .case-body ol,
  .case-body ul {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-left: 1.25rem;
    margin: 1rem 0 2rem 0;
  }

  .case-body li {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .case-body li strong {
    color: var(--text-primary);
  }

  /* Architectural Solution Cards */
  .arch-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all var(--transition-fast);
  }
  .arch-card:hover {
    border-color: var(--border-hover);
    background: var(--bg-hover);
  }

  .arch-card h3 {
    margin: 0;
    font-size: 1.15rem;
    color: var(--accent);
  }

  .arch-card p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .case-title {
      font-size: 1.85rem;
    }
    .case-meta-grid {
      grid-template-columns: 1fr;
    }
    .meta-cell-stack {
      grid-column: span 1;
    }
    .mobile-video-wrapper {
      max-width: 260px;
      border-width: 6px;
    }
  }
</style>
