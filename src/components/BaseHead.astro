---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/moscas-app.jpg";
import { SITE_TITLE } from "../consts";
import { Font } from "astro:assets";

import type { TranslationKey } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  titleKey?: TranslationKey;
  descriptionKey?: TranslationKey;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = FallbackImage,
  titleKey,
  descriptionKey,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
<link rel="icon" href="/work.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Sync HTML lang & theme attributes before paint (anti-FOUC) -->
<script is:inline>
  (() => {
    try {
      // 1. Language sync
      const savedLang = localStorage.getItem('preferred_lang');
      const nav = (navigator.language || '').toLowerCase();
      let lang = 'en';
      if (savedLang === 'en' || savedLang === 'pt' || savedLang === 'es') {
        lang = savedLang;
      } else if (nav.startsWith('pt')) {
        lang = 'pt';
      } else if (nav.startsWith('es')) {
        lang = 'es';
      }
      document.documentElement.lang = lang;

      // 2. Theme sync (anti-FOUC)
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || (!savedTheme && window.matchMedia('(prefers-color-scheme: light)').matches)) {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
    } catch (e) {}
  })();
</script>

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title data-i18n={titleKey}>{title}</title>
<meta name="description" content={description} data-i18n={descriptionKey} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
