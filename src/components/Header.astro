---
import HeaderLink from "./HeaderLink.astro";
---

<header id="site-header">
  <nav class="nav-container">
    <!-- Brand / Logo -->
    <a href="/" class="brand-link" aria-label="Erick Bustamante — Home">
      <div class="brand-badge" aria-hidden="true">
        <span>EB</span>
      </div>
      <div class="brand-info">
        <span class="brand-title">Erick Bustamante</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="internal-links" id="desktop-nav-links">
      <HeaderLink href="/" data-i18n="nav.home">Home</HeaderLink>
      <HeaderLink href="/#experiencia" data-i18n="nav.experience">Experience</HeaderLink>
      <HeaderLink href="/#proyectos" data-i18n="nav.projects">Projects</HeaderLink>
      <HeaderLink href="/about" data-i18n="nav.about">About</HeaderLink>
    </div>

    <!-- Actions: Theme Toggle + Language Selector + Socials + Mobile Toggle -->
    <div class="header-right">
      <!-- Theme Toggle Button (Minimalist SVG icons) -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="icon-btn theme-toggle-btn"
        data-i18n-aria-label="nav.theme_toggle_aria"
        aria-label="Toggle color theme"
      >
        <!-- Sun icon (visible in Dark Mode) -->
        <svg
          class="theme-icon sun-icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41m14.14-14.14-1.41 1.41"/>
        </svg>

        <!-- Moon icon (visible in Light Mode) -->
        <svg
          class="theme-icon moon-icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <!-- Language Selector EN | PT | ES -->
      <div
        class="lang-selector"
        role="group"
        data-i18n-aria-label="nav.lang_selector_aria"
        aria-label="Select language"
      >
        <button
          type="button"
          class="lang-btn"
          data-lang="en"
          aria-pressed="false"
          aria-label="English"
        >EN</button>
        <span class="lang-divider" aria-hidden="true">/</span>
        <button
          type="button"
          class="lang-btn"
          data-lang="pt"
          aria-pressed="false"
          aria-label="Português"
        >PT</button>
        <span class="lang-divider" aria-hidden="true">/</span>
        <button
          type="button"
          class="lang-btn"
          data-lang="es"
          aria-pressed="false"
          aria-label="Español"
        >ES</button>
      </div>

      <!-- Social Links (Desktop) -->
      <div class="social-links">
        <a
          href="https://www.linkedin.com/in/erick-andrew-bustamante-flores-6a1a4623a/"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n-aria-label="nav.linkedin_aria"
          aria-label="Connect with Erick on LinkedIn"
          class="icon-btn"
        >
          <span class="sr-only" data-i18n="nav.linkedin_aria">Connect with Erick on LinkedIn</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6c0-.89-.72-1.6-1.6-1.6Z"/>
          </svg>
        </a>

        <a
          href="https://github.com/ErickAndrewBF"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n-aria-label="nav.github_aria"
          aria-label="View project source code on GitHub"
          class="icon-btn"
        >
          <span class="sr-only" data-i18n="nav.github_aria">View project source code on GitHub</span>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="icon-btn mobile-toggle-btn"
        data-i18n-aria-label="nav.menu_toggle_aria"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg
          class="hamburger-icon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Collapsible Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <a href="/" class="mobile-link" data-i18n="nav.home">Home</a>
      <a href="/#experiencia" class="mobile-link" data-i18n="nav.experience">Experience</a>
      <a href="/#proyectos" class="mobile-link" data-i18n="nav.projects">Projects</a>
      <a href="/about" class="mobile-link" data-i18n="nav.about">About</a>

      <div class="mobile-socials-row">
        <a
          href="https://www.linkedin.com/in/erick-andrew-bustamante-flores-6a1a4623a/"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-social-link"
        >
          LinkedIn
        </a>
        <span class="lang-divider">•</span>
        <a
          href="https://github.com/ErickAndrewBF"
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-social-link"
        >
          GitHub
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  import { initI18n } from "../i18n/utils";

  function setupHeader() {
    // 1. Initialize i18n
    initI18n();

    // 2. Theme Toggle Controller
    const themeBtn = document.getElementById("theme-toggle-btn");
    if (themeBtn && !themeBtn.dataset.bound) {
      themeBtn.dataset.bound = "true";
      themeBtn.addEventListener("click", () => {
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        const nextTheme = isLight ? "dark" : "light";
        if (nextTheme === "light") {
          document.documentElement.setAttribute("data-theme", "light");
        } else {
          document.documentElement.removeAttribute("data-theme");
        }
        localStorage.setItem("theme", nextTheme);
      });
    }

    // 3. Mobile Navigation Drawer Toggle
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileDrawer = document.getElementById("mobile-nav-drawer");
    if (mobileBtn && mobileDrawer && !mobileBtn.dataset.bound) {
      mobileBtn.dataset.bound = "true";

      const toggleMenu = (open?: boolean) => {
        const isOpen = open !== undefined ? open : !mobileDrawer.classList.contains("is-open");
        mobileDrawer.classList.toggle("is-open", isOpen);
        mobileDrawer.setAttribute("aria-hidden", (!isOpen).toString());
        mobileBtn.setAttribute("aria-expanded", isOpen.toString());
      };

      mobileBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      // Close drawer when clicking any mobile link
      mobileDrawer.querySelectorAll(".mobile-link").forEach((link) => {
        link.addEventListener("click", () => toggleMenu(false));
      });

      // Close drawer when clicking outside
      document.addEventListener("click", (e) => {
        if (!mobileDrawer.contains(e.target as Node) && !mobileBtn.contains(e.target as Node)) {
          toggleMenu(false);
        }
      });
    }

    // 4. ScrollSpy with IntersectionObserver
    setupScrollSpy();
  }

  function setupScrollSpy() {
    const isHome = window.location.pathname === "/" || window.location.pathname === "";
    const allLinks = document.querySelectorAll<HTMLAnchorElement>(".internal-links a, .mobile-link");

    if (!isHome) {
      // On subpages (e.g. /about), keep the subpage active
      allLinks.forEach((link) => {
        const href = link.getAttribute("href");
        if (href === window.location.pathname) {
          link.classList.add("active");
        } else {
          link.classList.remove("active");
        }
      });
      return;
    }

    // On Home Page: observe sections by ID (#inicio, #experiencia, #proyectos)
    const sectionIds = ["inicio", "experiencia", "proyectos"];
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((s): s is HTMLElement => s !== null);

    if (sections.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        let topEntry: IntersectionObserverEntry | null = null;
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (!topEntry || entry.intersectionRatio > topEntry.intersectionRatio) {
              topEntry = entry;
            }
          }
        });

        if (topEntry && (topEntry as IntersectionObserverEntry).target) {
          const activeId = (topEntry as IntersectionObserverEntry).target.id;
          allLinks.forEach((link) => {
            const href = link.getAttribute("href") || "";
            const isMatch =
              href === `#${activeId}` ||
              href === `/#${activeId}` ||
              (activeId === "inicio" && (href === "/" || href === "/#inicio"));
            link.classList.toggle("active", isMatch);
          });
        }
      },
      {
        rootMargin: "-15% 0px -60% 0px",
        threshold: [0.1, 0.3, 0.6],
      }
    );

    sections.forEach((sec) => observer.observe(sec));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHeader);
  } else {
    setupHeader();
  }
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    height: var(--header-height);
    background: var(--bg-glass);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .nav-container {
    max-width: var(--max-width);
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* Brand Link */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-primary);
    transition: opacity var(--transition-fast);
    flex-shrink: 0;
  }
  .brand-link:hover {
    opacity: 0.9;
  }

  .brand-badge {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .brand-info {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  /* Desktop Navigation Links */
  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .internal-links :global(a) {
    color: var(--text-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .internal-links :global(a:hover) {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .internal-links :global(a.active) {
    color: var(--text-primary);
    background: var(--bg-hover);
    font-weight: 600;
    border-bottom: 2px solid var(--accent);
  }

  /* Header Actions */
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0;
  }

  .icon-btn:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
    border-color: var(--border-subtle);
  }

  /* Theme Toggle Icon Switching */
  .theme-toggle-btn {
    color: var(--text-secondary);
  }
  .theme-toggle-btn:hover {
    color: var(--accent);
  }

  .sun-icon {
    display: block;
  }
  .moon-icon {
    display: none;
  }

  /* When Light Mode is active */
  :global(:root[data-theme="light"]) .sun-icon {
    display: none;
  }
  :global(:root[data-theme="light"]) .moon-icon {
    display: block;
  }

  /* Language Selector (Pill Design) */
  .lang-selector {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.3rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    gap: 0.15rem;
  }

  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    transition: all var(--transition-fast);
    line-height: 1;
  }

  .lang-btn:hover {
    color: var(--text-primary);
  }

  .lang-btn.active {
    background: var(--bg-elevated);
    color: var(--accent);
    font-weight: 700;
  }

  .lang-divider {
    color: var(--border-default);
    font-size: 0.65rem;
    user-select: none;
    padding: 0 0.1rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Mobile Hamburger Button */
  .mobile-toggle-btn {
    display: none;
  }

  /* Mobile Navigation Drawer */
  .mobile-drawer {
    display: none;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.4);
    transition: all var(--transition-fast);
  }

  .mobile-drawer.is-open {
    display: block;
  }

  .mobile-drawer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem 1.5rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: var(--text-primary);
    background: var(--bg-hover);
  }
  .mobile-link.active {
    color: var(--accent);
    font-weight: 600;
  }

  .mobile-socials-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-social-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-tertiary);
    text-decoration: none;
  }
  .mobile-social-link:hover {
    color: var(--accent);
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS (<= 768px)
     ========================================================================== */
  @media (max-width: 768px) {
    .nav-container {
      padding: 0 1rem;
      gap: 0.75rem;
    }

    #desktop-nav-links {
      display: none;
    }

    .social-links {
      display: none;
    }

    .mobile-toggle-btn {
      display: inline-flex;
    }

    .brand-title {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .brand-title {
      display: none;
    }
  }
</style>
