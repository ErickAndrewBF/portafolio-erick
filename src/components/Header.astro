---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
---

<header>
  <nav>
    <h2><a href="/">{SITE_TITLE}</a></h2>

    <div class="internal-links">
      <HeaderLink href="/" data-i18n="nav.home">Home</HeaderLink>
      <HeaderLink href="/#experiencia" data-i18n="nav.experience">Experience</HeaderLink>
      <HeaderLink href="/#proyectos" data-i18n="nav.projects">Projects</HeaderLink>
    </div>

    <div class="header-right">
      <div class="social-links">
        <a
          href="https://www.linkedin.com/in/erick-andrew-bustamante-flores-6a1a4623a/"
          target="_blank"
          data-i18n-aria-label="nav.linkedin_aria"
          aria-label="Connect with Erick on LinkedIn"
        >
          <span class="sr-only" data-i18n="nav.linkedin_aria">Connect with Erick on LinkedIn</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
            <path
              fill="currentColor"
              d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
            ></path>
          </svg>
        </a>
        <a
          href="https://github.com/ErickAndrewBF/portafolio-erick.git"
          target="_blank"
          data-i18n-aria-label="nav.github_aria"
          aria-label="View project source code on GitHub"
        >
          <span class="sr-only" data-i18n="nav.github_aria">View project source code on GitHub</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </div>

      <!-- Language Selector EN | PT | ES -->
      <div
        class="lang-selector"
        role="group"
        data-i18n-aria-label="nav.lang_selector_aria"
        aria-label="Select language"
      >
        <button
          type="button"
          class="lang-btn"
          data-lang="en"
          aria-pressed="false"
          aria-label="English"
        >EN</button>
        <span class="lang-divider" aria-hidden="true">|</span>
        <button
          type="button"
          class="lang-btn"
          data-lang="pt"
          aria-pressed="false"
          aria-label="Português"
        >PT</button>
        <span class="lang-divider" aria-hidden="true">|</span>
        <button
          type="button"
          class="lang-btn"
          data-lang="es"
          aria-pressed="false"
          aria-label="Español"
        >ES</button>
      </div>
    </div>
  </nav>
</header>

<script>
  import { initI18n } from "../i18n/utils";

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => initI18n());
  } else {
    initI18n();
  }
</script>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
    color: var(--black);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
  }
  nav a {
    padding: 0.5em;
    color: var(--black);
    text-decoration: none;
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .social-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .social-links a {
    display: flex;
    align-items: center;
    color: #4a5568;
    transition: color 0.2s ease;
  }
  .social-links a:hover {
    color: #000;
  }

  /* Language Selector Styles */
  .lang-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: #f1f5f9;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    border: 1px solid #e2e8f0;
  }
  .lang-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    color: #64748b;
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: all 0.15s ease;
    line-height: 1;
  }
  .lang-btn:hover {
    color: #0f172a;
  }
  .lang-btn.active {
    color: var(--accent);
    font-weight: 800;
  }
  .lang-divider {
    color: #cbd5e1;
    font-size: 0.75rem;
    user-select: none;
  }

  .internal-links {
    display: flex;
    align-items: center;
  }
  .internal-links a {
    text-decoration: none;
    color: #4a5568;
    padding: 0.5rem 0;
    margin: 0 1rem;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    transition: all 0.2s ease;
  }
  .internal-links a:hover {
    color: #000;
    border-bottom-color: #000;
  }

  @media (max-width: 720px) {
    .social-links {
      display: none;
    }
    .internal-links a {
      margin: 0 0.5rem;
      font-size: 0.9rem;
    }
    .lang-selector {
      padding: 0.2rem 0.45rem;
      gap: 0.2rem;
    }
    .lang-btn {
      font-size: 0.75rem;
      padding: 0.1rem 0.2rem;
    }
  }
</style>
