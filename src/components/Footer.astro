---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-container">
    <!-- Contact CTA Block -->
    <div class="footer-cta-card">
      <div class="cta-content">
        <div class="status-indicator">
          <span class="status-dot" aria-hidden="true"></span>
          <span>Available for High-Impact Roles & Research</span>
        </div>
        <h3 class="cta-title" data-i18n="footer.cta_title">
          Let's build something exceptional together
        </h3>
        <p class="cta-desc" data-i18n="footer.cta_desc">
          Interested in technical collaboration, AI/ML engineering, or high-scale software systems? Feel free to reach out.
        </p>
      </div>
      <div class="cta-action">
        <a
          href="mailto:171943@unsaac.edu.pe"
          class="cta-email-btn"
          data-i18n-aria-label="footer.email_aria"
          aria-label="Send email to Erick Bustamante"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <span data-i18n="footer.contact_btn">Get in Touch</span>
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m-7-7 7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Direct Channels List -->
    <div class="contact-channels">
      <!-- Email -->
      <a
        href="mailto:171943@unsaac.edu.pe"
        class="channel-item"
        data-i18n-aria-label="footer.email_aria"
        aria-label="Email"
      >
        <div class="channel-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </div>
        <div class="channel-meta">
          <span class="channel-label">Email</span>
          <span class="channel-value font-mono">171943@unsaac.edu.pe</span>
        </div>
      </a>

      <!-- GitHub -->
      <a
        href="https://github.com/ErickAndrewBF"
        target="_blank"
        rel="noopener noreferrer"
        class="channel-item"
        data-i18n-aria-label="nav.github_aria"
        aria-label="GitHub"
      >
        <div class="channel-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z"/>
          </svg>
        </div>
        <div class="channel-meta">
          <span class="channel-label">GitHub</span>
          <span class="channel-value font-mono">@ErickAndrewBF</span>
        </div>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/erick-andrew-bustamante-flores-6a1a4623a/"
        target="_blank"
        rel="noopener noreferrer"
        class="channel-item"
        data-i18n-aria-label="nav.linkedin_aria"
        aria-label="LinkedIn"
      >
        <div class="channel-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6c0-.89-.72-1.6-1.6-1.6Z"/>
          </svg>
        </div>
        <div class="channel-meta">
          <span class="channel-label">LinkedIn</span>
          <span class="channel-value font-mono">in/erick-andrew</span>
        </div>
      </a>

      <!-- ORCID -->
      <a
        href="https://orcid.org"
        target="_blank"
        rel="noopener noreferrer"
        class="channel-item"
        data-i18n-aria-label="footer.orcid_aria"
        aria-label="ORCID"
      >
        <div class="channel-icon orcid-icon" aria-hidden="true">
          <svg viewBox="0 0 256 256" width="18" height="18" fill="currentColor">
            <path d="M128 0C57.3 0 0 57.3 0 128s57.3 128 128 128 128-57.3 128-128S198.7 0 128 0zm-35.4 185.3H68.8V82.4h23.8v102.9zm-11.9-117c-8 0-14.5-6.5-14.5-14.5s6.5-14.5 14.5-14.5 14.5 6.5 14.5 14.5-6.5 14.5-14.5 14.5zm106.6 63.8c0 30.1-22.1 53.2-57.2 53.2h-32.9V82.4h32.9c35.1 0 57.2 23.1 57.2 53.2zm-24.8 0c0-18.7-12.8-31.5-32.4-31.5h-8.9v63.1h8.9c19.6 0 32.4-12.8 32.4-31.6z"/>
          </svg>
        </div>
        <div class="channel-meta">
          <span class="channel-label">ORCID</span>
          <span class="channel-value font-mono">Researcher Profile</span>
        </div>
      </a>
    </div>

    <!-- Bottom Bar: Copyright & Location -->
    <div class="footer-bottom">
      <div class="bottom-left">
        <p class="copyright">
          &copy; {today.getFullYear()} Erick Andrew Bustamante Flores. <span data-i18n="footer.rights">All rights reserved.</span>
        </p>
      </div>
      <div class="bottom-right">
        <span class="location-tag font-mono" data-i18n="footer.location">
          Brasília, Brazil • UnB GPDS
        </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    background: var(--bg-base);
    border-top: 1px solid var(--border-subtle);
    padding: 4rem 1.5rem 3rem 1.5rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* CTA Card */
  .footer-cta-card {
    background: radial-gradient(circle at 85% 20%, rgba(59, 130, 246, 0.08) 0%, transparent 60%), var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    position: relative;
    overflow: hidden;
  }

  .cta-content {
    max-width: 620px;
  }

  .cta-content .status-indicator {
    margin-bottom: 0.85rem;
  }

  .cta-title {
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
  }

  .cta-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  .cta-action {
    flex-shrink: 0;
  }

  .cta-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.85rem 1.4rem;
    background: var(--accent);
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(59, 130, 246, 0.35);
    transition: all var(--transition-fast);
  }

  .cta-email-btn:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.45);
    color: #ffffff;
  }

  /* Contact Channels Grid */
  .contact-channels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .channel-item {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.15rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .channel-item:hover {
    border-color: var(--border-hover);
    background: var(--bg-hover);
    transform: translateY(-2px);
  }

  .channel-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    flex-shrink: 0;
    transition: color var(--transition-fast);
  }

  .channel-item:hover .channel-icon {
    color: var(--text-primary);
  }

  .orcid-icon svg {
    color: #a6ce39;
  }

  .channel-meta {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .channel-label {
    font-size: 0.75rem;
    color: var(--text-tertiary);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .channel-value {
    font-size: 0.82rem;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-tertiary);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright {
    margin: 0;
  }

  .location-tag {
    font-size: 0.78rem;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .contact-channels {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer-cta-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.75rem;
    }
    .cta-action {
      width: 100%;
    }
    .cta-email-btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 580px) {
    .contact-channels {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
