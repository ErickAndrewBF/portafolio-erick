---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";

import imgMoscas from "../assets/moscas-app.jpg";
import imgDron from "../assets/dron-app.png";
import imgQuechua from "../assets/quechua.webp";
import imgPerfil from "../assets/foto_perfil.jpg";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      titleKey="site.role"
    />
  </head>
  <body>
    <Header />

    <main class="landing-main">
      <!-- ====================================================================
           1. HERO SECTION
           ==================================================================== -->
      <section class="hero-section">
        <div class="hero-container">
          <div class="hero-content">
            <div class="hero-badge-wrap">
              <span class="status-indicator">
                <span class="status-dot" aria-hidden="true"></span>
                <span data-i18n="hero.badge">Available for Senior Roles & AI Research</span>
              </span>
            </div>

            <h1 class="hero-headline">
              <span class="hero-greeting" data-i18n="hero.greeting">Hi, I'm</span>
              <span class="hero-name" data-i18n="hero.name">Erick Bustamante</span>
            </h1>

            <p class="hero-role-title" data-i18n="hero.role">
              Full-Stack & AI Engineer
            </p>

            <p class="hero-tagline" data-i18n="hero.tagline">
              Bridging scalable production systems with applied AI research.
            </p>

            <p class="hero-bio" data-i18n="hero.bio">
              Master’s researcher at Universidade de Brasília (UnB / GPDS) and Senior Software Engineer. Experienced in building high-concurrency digital banking apps, custom HealthTech platforms, and state-of-the-art vector search algorithms.
            </p>

            <div class="hero-actions">
              <a
                id="hero-cv-btn"
                href="/cv/cv-en.pdf"
                target="_blank"
                download
                data-cv-download
                class="btn-primary"
                data-i18n-aria-label="action.download_cv"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <span data-i18n="action.download_cv">Download CV</span>
              </a>

              <a href="#proyectos" class="btn-secondary">
                <span data-i18n="action.view_projects">View Projects</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17l10-10M17 17V7H7"/>
                </svg>
              </a>

              <a href="mailto:171943@unsaac.edu.pe" class="btn-ghost">
                <span data-i18n="action.contact">Get in Touch</span>
              </a>
            </div>
          </div>

          <div class="hero-visual">
            <div class="avatar-frame">
              <Image
                src={imgPerfil}
                alt="Erick Bustamante"
                class="avatar-img"
                width={240}
                height={240}
                loading="eager"
              />
              <div class="avatar-ring" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           2. CREDIBILITY / METRICS BAR
           ==================================================================== -->
      <section class="metrics-section" aria-label="Highlights and Key Metrics">
        <div class="metrics-grid">
          <!-- Metric 1: Vector Search Speedup -->
          <div class="metric-card">
            <div class="metric-top">
              <span class="metric-value font-mono text-accent" data-i18n="metrics.m1_val">924x</span>
              <span class="metric-tag font-mono">Speedup</span>
            </div>
            <h4 class="metric-label" data-i18n="metrics.m1_label">Vector Search Speedup</h4>
            <p class="metric-desc" data-i18n="metrics.m1_desc">HNSW + NCD Low-Resource Thesis</p>
          </div>

          <!-- Metric 2: Research Publication -->
          <div class="metric-card">
            <div class="metric-top">
              <span class="metric-value font-mono text-emerald" data-i18n="metrics.m2_val">Springer</span>
              <span class="metric-tag font-mono">Paper</span>
            </div>
            <h4 class="metric-label" data-i18n="metrics.m2_label">Research Author</h4>
            <p class="metric-desc" data-i18n="metrics.m2_desc">Signal Processing & Applied ML</p>
          </div>

          <!-- Metric 3: NASA Space Apps -->
          <div class="metric-card">
            <div class="metric-top">
              <span class="metric-value font-mono text-accent" data-i18n="metrics.m3_val">NASA</span>
              <span class="metric-tag font-mono">Nominee</span>
            </div>
            <h4 class="metric-label" data-i18n="metrics.m3_label">Global Nominee</h4>
            <p class="metric-desc" data-i18n="metrics.m3_desc">Space Apps Challenge 2023</p>
          </div>

          <!-- Metric 4: Production Experience -->
          <div class="metric-card">
            <div class="metric-top">
              <span class="metric-value font-mono text-emerald" data-i18n="metrics.m4_val">3+ Yrs</span>
              <span class="metric-tag font-mono">Production</span>
            </div>
            <h4 class="metric-label" data-i18n="metrics.m4_label">Production Software</h4>
            <p class="metric-desc" data-i18n="metrics.m4_desc">FinTech, HealthTech & Mobile</p>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           3. PROJECTS & CASE STUDIES (BENTO GRID)
           ==================================================================== -->
      <section id="proyectos" class="section-block">
        <div class="section-header">
          <div class="section-badge font-mono" data-i18n="proj.section_badge">Featured Engineering</div>
          <h2 class="section-title" data-i18n="proj.section_title">🛠️ Projects & Case Studies</h2>
          <p class="section-sub" data-i18n="proj.section_desc">
            A selection of production-grade systems, hardware integrations, and applied AI research projects.
          </p>
        </div>

        <div class="bento-grid">
          <!-- BENTO ITEM 1: MASTER'S THESIS / AI RESEARCH (FEATURED SPAN-2) -->
          <div class="bento-card bento-featured">
            <div class="bento-content">
              <div class="card-badge-row">
                <span class="tech-tag highlight font-mono" data-i18n="proj.hnsw_badge">
                  Master's Thesis • AI Research
                </span>
                <span class="metric-badge font-mono" data-i18n="proj.hnsw_metric">
                  O(log N) Search • Up to 924x Speedup
                </span>
              </div>

              <h3 class="bento-title" data-i18n="proj.hnsw_title">
                Hybrid Vector Filtering for Low-Resource Text Classification
              </h3>

              <p class="bento-desc" data-i18n="proj.hnsw_desc">
                Novel architecture combining HNSW graph indexing with Normalized Compression Distance (NCD). Reduces search complexity from O(N) to O(log N) + O(K) with up to 924x speedup on benchmark datasets.
              </p>

              <div class="bento-tags">
                <span class="tech-tag">Python</span>
                <span class="tech-tag">PyTorch</span>
                <span class="tech-tag">HNSWLib</span>
                <span class="tech-tag">Information Theory (NCD)</span>
                <span class="tech-tag">NLP</span>
                <span class="tech-tag">NumPy</span>
              </div>

              <div class="bento-footer">
                <span class="bento-note font-mono">Universidade de Brasília • GPDS / PPGI</span>
              </div>
            </div>
          </div>

          <!-- BENTO ITEM 2: MOSCAS CLASSIFIER -->
          <div class="bento-card">
            <div class="bento-img-wrap">
              <Image src={imgMoscas} alt="Fruit Fly Pest Classifier" class="bento-thumbnail" width={600} />
            </div>
            <div class="bento-content">
              <div class="card-badge-row">
                <span class="tech-tag font-mono" data-i18n="proj.moscas_badge">
                  Computer Vision • Deep Learning
                </span>
              </div>

              <h3 class="bento-title" data-i18n="proj.moscas_title">
                AI-Powered Fruit Fly Classifier & Grad-CAM
              </h3>

              <p class="bento-desc" data-i18n="proj.moscas_desc">
                Full Stack web platform for agricultural pest diagnostics with PyTorch convolutional networks and real-time Grad-CAM explainability heatmaps.
              </p>

              <div class="bento-tags">
                <span class="tech-tag">React</span>
                <span class="tech-tag">Flask</span>
                <span class="tech-tag">PyTorch</span>
                <span class="tech-tag">Grad-CAM</span>
              </div>

              <div class="bento-footer">
                <a href="/caso-moscas" class="card-action-link" data-i18n="action.view_case_study">
                  Read Case Study &rarr;
                </a>
                <a
                  href="https://github.com/ErickAndrewBF/moscas-frontend.git"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card-github-link"
                >
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                  </svg>
                  GitHub
                </a>
              </div>
            </div>
          </div>

          <!-- BENTO ITEM 3: NATIVE DRONE APP -->
          <div class="bento-card">
            <div class="bento-img-wrap">
              <Image src={imgDron} alt="Native Drone Telemetry" class="bento-thumbnail" width={600} />
            </div>
            <div class="bento-content">
              <div class="card-badge-row">
                <span class="tech-tag font-mono" data-i18n="proj.dron_badge">
                  Native Android • Robotics SDK
                </span>
              </div>

              <h3 class="bento-title" data-i18n="proj.dron_title">
                Native Drone Telemetry & Livestock Tracking
              </h3>

              <p class="bento-desc" data-i18n="proj.dron_desc">
                High-performance Android application interfacing with DJI Mobile SDK to process raw video feeds and track livestock in real time.
              </p>

              <div class="bento-tags">
                <span class="tech-tag">Kotlin</span>
                <span class="tech-tag">Android SDK</span>
                <span class="tech-tag">DJI SDK</span>
                <span class="tech-tag">Computer Vision</span>
              </div>

              <div class="bento-footer">
                <a href="/caso-dron" class="card-action-link" data-i18n="action.view_case_study">
                  Read Case Study &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- BENTO ITEM 4: QUECHUA MEDICAL SPEECH -->
          <div class="bento-card">
            <div class="bento-img-wrap">
              <Image src={imgQuechua} alt="Quechua Speech Corpus" class="bento-thumbnail" width={600} />
            </div>
            <div class="bento-content">
              <div class="card-badge-row">
                <span class="tech-tag font-mono" data-i18n="proj.quechua_badge">
                  Distributed Backend • Audio S3
                </span>
              </div>

              <h3 class="bento-title" data-i18n="proj.quechua_title">
                Quechua Speech Corpus & Validation Pipeline
              </h3>

              <p class="bento-desc" data-i18n="proj.quechua_desc">
                Voice collection system for indigenous medical speech, integrating FastAPI routers, PostgreSQL state machines, and MinIO S3 presigned URLs.
              </p>

              <div class="bento-tags">
                <span class="tech-tag">FastAPI</span>
                <span class="tech-tag">PostgreSQL</span>
                <span class="tech-tag">MinIO (S3)</span>
                <span class="tech-tag">Java / Kotlin</span>
              </div>

              <div class="bento-footer">
                <a href="/caso-quechua" class="card-action-link" data-i18n="action.view_case_study">
                  Read Case Study &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           4. WORK EXPERIENCE TIMELINE
           ==================================================================== -->
      <section id="experiencia" class="section-block">
        <div class="section-header">
          <div class="section-badge font-mono" data-i18n="exp.section_badge">Career Timeline</div>
          <h2 class="section-title" data-i18n="exp.section_title">💼 Work Experience</h2>
          <p class="section-sub" data-i18n="exp.section_desc">
            Proven track record architecting mission-critical digital banking, acoustic biometric diagnostics, and enterprise medical systems.
          </p>
        </div>

        <div class="timeline-container">
          <!-- Item 1: Caja Cusco -->
          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="timeline-dot"></div>
            </div>
            <div class="timeline-body">
              <div class="timeline-meta">
                <span class="timeline-role" data-i18n="exp.cajacusco_role">Mobile & Backend Engineer</span>
                <span class="timeline-period font-mono" data-i18n="exp.cajacusco_date">Nov 2024 — Feb 2026</span>
              </div>
              <h3 class="timeline-company" data-i18n="exp.cajacusco_title">Caja Municipal Cusco</h3>
              <p class="timeline-summary" data-i18n="exp.cajacusco_summary">
                Engineered core features and microservices for the Wayki App mobile banking ecosystem. Optimized critical SQL queries, strengthened security, and enhanced performance for hundreds of thousands of active financial users.
              </p>
              <div class="timeline-tags">
                <span class="tech-tag">Kotlin</span>
                <span class="tech-tag">Spring Boot</span>
                <span class="tech-tag">SQL Server</span>
                <span class="tech-tag">Android SDK</span>
                <span class="tech-tag">Microservices</span>
              </div>
              <div class="timeline-link">
                <a
                  href="https://play.google.com/store/apps/details?id=com.pe.cajacusco.movil&hl=es"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                  data-i18n="exp.cajacusco_link"
                >
                  View App on Play Store &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Item 2: ML Orange -->
          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="timeline-dot"></div>
            </div>
            <div class="timeline-body">
              <div class="timeline-meta">
                <span class="timeline-role" data-i18n="exp.mlorange_role">Full-Stack Software Engineer</span>
                <span class="timeline-period font-mono" data-i18n="exp.mlorange_date">Aug 2024 — Nov 2024</span>
              </div>
              <h3 class="timeline-company" data-i18n="exp.mlorange_title">ML Orange (XMachina)</h3>
              <p class="timeline-summary" data-i18n="exp.mlorange_summary">
                Architected a cross-platform mobile solution for acoustic analysis and occupational health screening. Built accompanying Electron desktop administration software and Express backend with MariaDB.
              </p>
              <div class="timeline-tags">
                <span class="tech-tag">React Native</span>
                <span class="tech-tag">React</span>
                <span class="tech-tag">Electron</span>
                <span class="tech-tag">Express</span>
                <span class="tech-tag">MariaDB</span>
                <span class="tech-tag">Audio Processing</span>
              </div>
              <div class="timeline-link">
                <a
                  href="https://www.linkedin.com/company/ex-machina-si/posts/?feedView=all"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                  data-i18n="exp.mlorange_link"
                >
                  View LinkedIn Profile &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Item 3: Smart Cities Perú -->
          <div class="timeline-item">
            <div class="timeline-marker">
              <div class="timeline-dot"></div>
            </div>
            <div class="timeline-body">
              <div class="timeline-meta">
                <span class="timeline-role" data-i18n="exp.smartcities_role">Frontend & Systems Engineer</span>
                <span class="timeline-period font-mono" data-i18n="exp.smartcities_date">Nov 2022 — Aug 2023</span>
              </div>
              <h3 class="timeline-company" data-i18n="exp.smartcities_title">Smart Cities Perú</h3>
              <p class="timeline-summary" data-i18n="exp.smartcities_summary">
                Executed complete architectural refactoring of corporate Extranet and Intranet systems for Consettur. Designed and engineered responsive interfaces for Macsalud Clinic’s hospital ERP.
              </p>
              <div class="timeline-tags">
                <span class="tech-tag">Angular</span>
                <span class="tech-tag">JavaScript / TypeScript</span>
                <span class="tech-tag">SQL Server</span>
                <span class="tech-tag">Figma</span>
              </div>
              <div class="timeline-link">
                <a
                  href="https://www.linkedin.com/company/smart-cities-peru-sac/posts/?feedView=all"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-link"
                  data-i18n="exp.smartcities_link"
                >
                  View LinkedIn Profile &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           5. TECH STACK BY DOMAIN (4 COLUMNS)
           ==================================================================== -->
      <section class="section-block">
        <div class="section-header">
          <div class="section-badge font-mono" data-i18n="stack.section_badge">Technical Capabilities</div>
          <h2 class="section-title" data-i18n="stack.section_title">⚡ Tech Stack by Domain</h2>
          <p class="section-sub" data-i18n="stack.section_desc">
            Battle-tested technologies and tools utilized across production software engineering and academic scientific research.
          </p>
        </div>

        <div class="stack-domain-grid">
          <!-- Domain 1: AI / ML & Research -->
          <div class="stack-col">
            <div class="stack-col-header">
              <div class="stack-icon-badge" aria-hidden="true">🧠</div>
              <div>
                <h3 class="stack-col-title" data-i18n="stack.col1_title">AI / ML & Research</h3>
                <span class="stack-col-desc" data-i18n="stack.col1_desc">Deep Learning, Vector Search & NLP</span>
              </div>
            </div>
            <ul class="stack-items font-mono">
              <li><span>PyTorch</span><span class="stack-type">Framework</span></li>
              <li><span>Python</span><span class="stack-type">Core</span></li>
              <li><span>HNSWLib</span><span class="stack-type">Vector DB</span></li>
              <li><span>NCD / Info Theory</span><span class="stack-type">Algorithm</span></li>
              <li><span>OpenCV</span><span class="stack-type">Vision</span></li>
              <li><span>Scikit-Learn</span><span class="stack-type">Stats</span></li>
              <li><span>Grad-CAM</span><span class="stack-type">Explainability</span></li>
            </ul>
          </div>

          <!-- Domain 2: Backend & Systems -->
          <div class="stack-col">
            <div class="stack-col-header">
              <div class="stack-icon-badge" aria-hidden="true">⚙️</div>
              <div>
                <h3 class="stack-col-title" data-i18n="stack.col2_title">Backend & Systems</h3>
                <span class="stack-col-desc" data-i18n="stack.col2_desc">Distributed APIs, DBs & Cloud Storage</span>
              </div>
            </div>
            <ul class="stack-items font-mono">
              <li><span>Java / Spring Boot</span><span class="stack-type">Enterprise</span></li>
              <li><span>FastAPI</span><span class="stack-type">Async API</span></li>
              <li><span>PostgreSQL</span><span class="stack-type">RDBMS</span></li>
              <li><span>SQL Server</span><span class="stack-type">Banking</span></li>
              <li><span>MinIO (S3)</span><span class="stack-type">Object Store</span></li>
              <li><span>Express.js / Node</span><span class="stack-type">Microservices</span></li>
              <li><span>Redis</span><span class="stack-type">Caching</span></li>
            </ul>
          </div>

          <!-- Domain 3: Frontend & Mobile -->
          <div class="stack-col">
            <div class="stack-col-header">
              <div class="stack-icon-badge" aria-hidden="true">📱</div>
              <div>
                <h3 class="stack-col-title" data-i18n="stack.col3_title">Frontend & Mobile</h3>
                <span class="stack-col-desc" data-i18n="stack.col3_desc">Modern Web SPAs & Native Mobile Apps</span>
              </div>
            </div>
            <ul class="stack-items font-mono">
              <li><span>TypeScript</span><span class="stack-type">Core</span></li>
              <li><span>Kotlin (Android)</span><span class="stack-type">Native Mobile</span></li>
              <li><span>React / Next.js</span><span class="stack-type">Web SPA</span></li>
              <li><span>React Native</span><span class="stack-type">Cross Mobile</span></li>
              <li><span>Angular</span><span class="stack-type">Enterprise</span></li>
              <li><span>Astro</span><span class="stack-type">SSG / Islands</span></li>
              <li><span>Electron</span><span class="stack-type">Desktop</span></li>
            </ul>
          </div>

          <!-- Domain 4: Infra & Engineering -->
          <div class="stack-col">
            <div class="stack-col-header">
              <div class="stack-icon-badge" aria-hidden="true">🛠️</div>
              <div>
                <h3 class="stack-col-title" data-i18n="stack.col4_title">Infra & Engineering</h3>
                <span class="stack-col-desc" data-i18n="stack.col4_desc">DevOps, Tooling, Hardware SDKs & Design</span>
              </div>
            </div>
            <ul class="stack-items font-mono">
              <li><span>Docker</span><span class="stack-type">Containers</span></li>
              <li><span>Git / GitHub Actions</span><span class="stack-type">CI / CD</span></li>
              <li><span>Linux / Bash</span><span class="stack-type">Environment</span></li>
              <li><span>DJI Mobile SDK</span><span class="stack-type">Hardware</span></li>
              <li><span>Figma</span><span class="stack-type">UI / UX</span></li>
              <li><span>Postman</span><span class="stack-type">API Testing</span></li>
              <li><span>Markdown / LaTeX</span><span class="stack-type">Research</span></li>
            </ul>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Landing Main Layout */
  .landing-main {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-top: 3.5rem;
  }

  /* Section Header Shared */
  .section-block {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-badge {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .section-title {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
